# Native tools come from Guix; Python-distributed CLIs come from the uv lockfile.
watch_file manifest.scm pyproject.toml uv.lock .python-version
guix_environment=$(guix shell --manifest=manifest.scm --search-paths) || return
eval "$guix_environment"
unset guix_environment

export CC=clang
export CXX=clang++
# Binaries linked with Guix's toolchain, such as build scripts, need GCC's
# runtime. Expose only that directory: adding the whole profile library
# directory would also override host glibc and can break host tools.
guix_profile_lib="$(dirname "$(dirname "$(command -v clang)")")/lib"
path_add LD_LIBRARY_PATH "$(dirname "$(readlink -f "$guix_profile_lib/libgcc_s.so.1")")"
unset guix_profile_lib

# Guix Git needs an explicit path to the host's certificate trust bundle.
if [[ -z "${GIT_SSL_CAINFO:-}" && -f /etc/ssl/certs/ca-certificates.crt ]]; then
  export GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt
fi

uv sync --locked || return
export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"

# Machine-local settings; gitignored.
source_env_if_exists .envrc.local
